# Required for voice input, photo diagnosis and LLM advice (without it the app runs in offline-rules demo mode)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Hindsight memory server (docker run ... ghcr.io/vectorize-io/hindsight:latest). Leave empty to use local JSON memory.
# Uncomment after starting the Hindsight docker container:
# HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# Optional: live mandi prices from Agmarknet (free key at data.gov.in)
DATA_GOV_API_KEY=

# Optional: WhatsApp via Twilio. Set the sandbox webhook to <PUBLIC_BASE_URL>/webhook/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public URL of this server (e.g. from ngrok) so WhatsApp can fetch the voice reply
PUBLIC_BASE_URL=
